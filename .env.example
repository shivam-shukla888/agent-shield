# ============================================================
# AgentGuard — Production Environment Variables
# ============================================================
# Copy this file to .env and fill in production values.
# NEVER commit .env with real secrets to version control.
# ============================================================

# ---------- Application Server ----------
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- Authentication ----------
# Master API key for securing /api/v1/* endpoints.
# Generate a strong random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTSHIELD_API_KEY=changeme-generate-a-real-key

# ---------- Rate Limiting ----------
# Maximum requests per minute per IP address on scan endpoints.
AGENTSHIELD_RATE_LIMIT_RPM=60

# ---------- Database ----------
# PostgreSQL connection URL for production persistence.
# Leave blank or unset to use in-memory storage (development only).
DATABASE_URL=postgresql://agentguard:changeme@postgres:5432/agentguard

# ---------- LLM Provider (Optional) ----------
# Provider backend: fake | openai | anthropic | groq | ollama | custom | none
AGENTSHIELD_LLM_PROVIDER=fake

# LLM API key (required for openai, anthropic, groq).
AGENTSHIELD_LLM_API_KEY=

# LLM model identifier (e.g., gpt-4o, claude-3-opus).
AGENTSHIELD_LLM_MODEL=

# LLM request timeout in seconds (0.0 < timeout <= 300.0).
AGENTSHIELD_LLM_TIMEOUT=30.0

# Custom LLM endpoint URL (only used when provider is "custom" or "ollama").
AGENTSHIELD_LLM_ENDPOINT=
